<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.superhuman-mail.slack-issuer</string>
  <key>ProgramArguments</key><array><string>@RELEASE_ROOT@/slack-issuer.app/Contents/MacOS/launch</string></array>
  <key>UserName</key><string>@ISSUER_USER@</string>
  <key>GroupName</key><string>@ISSUER_PRIVATE_GROUP@</string>
  <key>KeepAlive</key><true/><key>RunAtLoad</key><true/>
</dict></plist>
